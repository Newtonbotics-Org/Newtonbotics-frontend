# Copy this file to .env and fill in your own values.
# Never commit .env — it is gitignored.

# Backend API URL (include the scheme and /api)
# https://your-backend.example.com/api  or  http://localhost:3006/api
NEXT_PUBLIC_API_URL=http://localhost:3006/api

# Canonical site URL used by sitemap, robots, and metadata
NEXT_PUBLIC_SITE_URL=https://www.newtonbotics.in

# Optional. Leave empty in public clones. Maintainers set this in deployment env.
NEXT_PUBLIC_ADMIN_URL=

# Cloudinary — use your own cloud. CLOUDINARY_API_SECRET is server-only; never expose it to the client.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
